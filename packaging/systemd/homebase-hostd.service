[Unit]
Description=Homebase privileged host service
Documentation=https://github.com/HusnuOkanCakir/homebase/blob/main/docs/security/privilege-boundaries.md
After=network.target
Requires=homebase-hostd.socket

# Give up rather than spin.
#
# Without a limit, a hostd that cannot start restarts every two seconds for
# ever: the journal fills with the same error, and because the socket is owned
# by systemd rather than by the service, every client request *connects* and
# then hangs waiting for a reply that never comes. A caller sees a timeout
# rather than a failure, which is the least diagnosable outcome available.
#
# Five attempts and then stay failed. `systemctl status` on a failed unit says
# what went wrong; a crash-loop says it seven hundred times and buries the first
# one.
#
# These belong in [Unit], not [Service]. systemd accepts them in [Service] only
# as deprecated aliases on some versions and silently ignores them on others —
# "Unknown key name 'StartLimitIntervalSec' in section 'Service', ignoring",
# which is a warning nobody reads and a limit that never applies.
StartLimitIntervalSec=60s
StartLimitBurst=5

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/libexec/homebase/hostd
Restart=on-failure
RestartSec=2s

# hostd must be root: it mounts disks, controls containers and restarts the
# machine. Everything below narrows what "root" means here.
#
# These are not performance settings. They are the difference between the
# privilege split being an architectural intention and being something the
# kernel enforces. Removing one to make a feature work is a security review.
User=root
Group=root

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# The leading `-` makes a missing path non-fatal.
#
# Without it, ProtectSystem=strict refuses to set up the mount namespace and
# hostd exits 226/NAMESPACE before running a line of Go — so a directory that
# has not been created yet stops the privileged service entirely. That is not
# hypothetical: /etc/homebase is created by homebase-core's maintainer script,
# so installing homebase-hostd on its own produced a service that could never
# start, and the error named a directory rather than the missing package.
ReadWritePaths=-/etc/homebase -/var/lib/homebase -/srv/homebase -/run/homebase -/var/log/homebase

# Mount units for managed disks are written here, and this is the widest grant
# in the file, so it is worth being explicit about what it costs.
#
# A hostd that can write to /etc/systemd/system can write a unit that runs
# anything as root at the next boot. That is persistence for an attacker who has
# already compromised hostd, and it is the one place this sandbox stops being
# defence in depth against exactly that.
#
# It is granted because the alternative is worse. Persistent mounts have to
# exist somewhere systemd reads at boot, and the only other candidate is
# /etc/fstab — a single file that the distribution and the installer also edit,
# where a mistake produces an unbootable machine rather than a failed unit. See
# ADR-0013.
#
# What narrows it is in the code rather than here: hostd only ever writes a path
# derived from a validated location id under /srv/homebase/storage, the unit
# name is derived from that path by systemd's own escaping rules, and the units
# it generates are .mount units, which have no Exec directives at all. A test
# asserts that last point, because it is the property that stops a generated
# unit being a way to run something.
#
# `systemctl enable` needs no access here: systemctl asks PID 1 to write the
# symlink, so that happens outside this sandbox.
ReadWritePaths=/etc/systemd/system

# AF_UNIX for the socket; AF_NETLINK for reading network state later. No
# AF_INET: hostd never talks to the network, and should not be able to.
RestrictAddressFamilies=AF_UNIX AF_NETLINK

RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete @cpu-emulation
SystemCallArchitectures=native
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RemoveIPC=yes

# One unit owns each directory.
#
# hostd deliberately does NOT declare StateDirectory=homebase or
# LogsDirectory=homebase, even though it writes to both. systemd chowns a
# declared directory to the unit's User, and core declares those same two as the
# homebase user — so whichever service started last would take ownership. That
# is how core's database ended up root-owned and unwritable by the account meant
# to own it.
#
# core owns /var/lib/homebase and /var/log/homebase because it is the
# unprivileged service that must write there; hostd is root and can write into
# them regardless.
#
# hostd owns /run/homebase, because the socket is its own, and
# /var/lib/homebase-hostd, which is its private bookkeeping — currently which
# applications were stopped deliberately. Declaring that one is safe precisely
# because no other unit names it. 0700 and root-owned: core must not be able to
# rewrite hostd's record of what it did.
RuntimeDirectory=homebase

# Without this, restarting hostd destroys the socket.
#
# systemd removes a RuntimeDirectory when the service stops — and the socket the
# *socket unit* owns lives inside it. So stopping hostd for a moment deletes
# /run/homebase/hostd.sock, while homebase-hostd.socket carries on reporting
# "active (running)" and "Listen: /run/homebase/hostd.sock" against a path that
# no longer exists. Nothing can connect again until the socket unit itself is
# restarted, and nothing says so: core simply reports that it cannot reach the
# part of itself that manages the server, for ever.
#
# Every upgrade restarts hostd. This was found when the homebase-apps package
# started doing the same thing to reload the catalogue.
#
# `yes` rather than `restart`: the directory's lifetime belongs to the socket
# unit, which outlives any individual run of the service. /run is a tmpfs, so it
# still goes away when the machine does.
RuntimeDirectoryPreserve=yes

StateDirectory=homebase-hostd
StateDirectoryMode=0700
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
