[Unit]
Description=Homebase privileged host service
Documentation=https://github.com/HusnuOkanCakir/homebase/blob/main/docs/security/privilege-boundaries.md
After=network.target
Requires=homebase-hostd.socket

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/libexec/homebase/hostd
Restart=on-failure
RestartSec=2s

# hostd must be root: it mounts disks, controls containers and restarts the
# machine. Everything below narrows what "root" means here.
#
# These are not performance settings. They are the difference between the
# privilege split being an architectural intention and being something the
# kernel enforces. Removing one to make a feature work is a security review.
User=root
Group=root

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/etc/homebase /var/lib/homebase /srv/homebase /run/homebase /var/log/homebase

# AF_UNIX for the socket; AF_NETLINK for reading network state later. No
# AF_INET: hostd never talks to the network, and should not be able to.
RestrictAddressFamilies=AF_UNIX AF_NETLINK

RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete @cpu-emulation
SystemCallArchitectures=native
ProtectKernelLogs=yes
ProtectClock=yes
ProtectHostname=yes
ProtectControlGroups=yes
ProtectKernelModules=yes
RemoveIPC=yes

# One unit owns each directory.
#
# hostd deliberately does NOT declare StateDirectory=homebase or
# LogsDirectory=homebase, even though it writes to both. systemd chowns a
# declared directory to the unit's User, and core declares those same two as the
# homebase user — so whichever service started last would take ownership. That
# is how core's database ended up root-owned and unwritable by the account meant
# to own it.
#
# core owns /var/lib/homebase and /var/log/homebase because it is the
# unprivileged service that must write there; hostd is root and can write into
# them regardless.
#
# hostd owns /run/homebase, because the socket is its own, and
# /var/lib/homebase-hostd, which is its private bookkeeping — currently which
# applications were stopped deliberately. Declaring that one is safe precisely
# because no other unit names it. 0700 and root-owned: core must not be able to
# rewrite hostd's record of what it did.
RuntimeDirectory=homebase
StateDirectory=homebase-hostd
StateDirectoryMode=0700
RuntimeDirectoryMode=0755

[Install]
WantedBy=multi-user.target
