[Unit]
Description=Homebase — open or close the file-sharing port
ConditionPathExists=/etc/homebase/share-firewall

[Service]
Type=oneshot
RemainAfterExit=no

# A fixed command with no arguments and a fixed port. The only thing that varies
# is whether to open or close, read from a root-only file.
#
# hostd does not do this itself because ufw writes /etc/ufw and reloads the
# kernel's packet filter, and neither is in that service's ProtectSystem=strict
# allowance. A root service that can rewrite the firewall can open the machine
# to the internet.
ExecStart=/usr/libexec/homebase/share-firewall

User=root
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
