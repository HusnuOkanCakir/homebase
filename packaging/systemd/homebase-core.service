[Unit]
Description=Homebase core service
Documentation=https://github.com/HusnuOkanCakir/homebase/blob/main/docs/architecture/services.md
After=network.target homebase-hostd.socket
Wants=homebase-hostd.socket

[Service]
Type=simple
ExecStart=/usr/libexec/homebase/core
Restart=on-failure
RestartSec=2s

# Reachable from the rest of the house.
#
# The binary's own default is 127.0.0.1, which is right for something somebody
# has just built and run, and wrong for this: a Homebase that answers only on
# its own keyboard is a Homebase nobody can use, since the entire product is
# opening it from a phone in another room. This package exists to make an
# appliance, so it says so here, once.
#
# It was previously left at the default and overridden in two other places —
# the installer and the browser test — each for its own good reason, which is
# exactly why nothing noticed that a real installation was unreachable.
#
# The firewall is what limits who can connect; the installer sets it. These are
# environment variables rather than part of ExecStart because a drop-in that has
# to restate the command line silently drops any flag added to it later.
#
# The ordinary ports, so the address somebody types is `https://attic.local`
# rather than a name with a number after it. A port number in the address is a
# thing to remember, get wrong, and be unable to guess — and this is the address
# printed on the machine's own screen for somebody to copy onto a phone.
#
# Plain HTTP exists only to redirect: somebody who types the name without a
# scheme lands on port 80, and browsers try http first.
Environment=HOMEBASE_LISTEN=0.0.0.0:80
Environment=HOMEBASE_LISTEN_TLS=0.0.0.0:443

# Unprivileged, and the whole design rests on it staying that way. If a feature
# appears to need more privilege here, it needs a new hostd operation instead.
User=homebase
Group=homebase

# The one exception, and it is narrow: binding a port below 1024.
#
# Everything else about this process stays unprivileged — it cannot read another
# user's files, cannot load modules, cannot change the system. CAP_NET_BIND_SERVICE
# lets it answer on 80 and 443 and does nothing else. The alternative is a
# reverse proxy running as root in front of it, which is a larger privileged
# surface to obtain a smaller result, or an address with a port number in it,
# which the person this is built for has to be told and has to remember.
# The bounding set is this capability and nothing else, so even a setuid binary
# would gain this process nothing further. Declared once: systemd takes the last
# assignment, and a second empty one further down would silently undo this — the
# kind of mistake that shows up as a service which will not bind port 443 and no
# indication why.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete @cpu-emulation @privileged
SystemCallArchitectures=native
RemoveIPC=yes

# core serves HTTP and talks to hostd over a Unix socket. It has no reason to
# open a raw socket or speak anything other than IP and AF_UNIX.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Its own state and the user data it manages. Notably absent: /etc/homebase,
# which is root-owned and written only through hostd — a configuration file core
# can rewrite is one an attacker who owns core can rewrite.
ReadWritePaths=/var/lib/homebase /srv/homebase /var/log/homebase

StateDirectory=homebase
StateDirectoryMode=0750
LogsDirectory=homebase
LogsDirectoryMode=0750

[Install]
WantedBy=multi-user.target
