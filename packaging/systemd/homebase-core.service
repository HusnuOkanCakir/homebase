[Unit]
Description=Homebase core service
Documentation=https://github.com/HusnuOkanCakir/homebase/blob/main/docs/architecture/services.md
After=network.target homebase-hostd.socket
Wants=homebase-hostd.socket

[Service]
Type=simple
ExecStart=/usr/libexec/homebase/core
Restart=on-failure
RestartSec=2s

# Unprivileged, and the whole design rests on it staying that way. If a feature
# appears to need more privilege here, it needs a new hostd operation instead.
User=homebase
Group=homebase

# Empty capability bounding set: even a setuid binary would gain this process
# nothing.
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallFilter=@system-service
SystemCallFilter=~@obsolete @cpu-emulation @privileged
SystemCallArchitectures=native
RemoveIPC=yes

# core serves HTTP and talks to hostd over a Unix socket. It has no reason to
# open a raw socket or speak anything other than IP and AF_UNIX.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

# Its own state and the user data it manages. Notably absent: /etc/homebase,
# which is root-owned and written only through hostd — a configuration file core
# can rewrite is one an attacker who owns core can rewrite.
ReadWritePaths=/var/lib/homebase /srv/homebase /var/log/homebase

StateDirectory=homebase
StateDirectoryMode=0750
LogsDirectory=homebase
LogsDirectoryMode=0750

[Install]
WantedBy=multi-user.target
