{
  "schema_version": 1,
  "modes": [
    "cpu",
    "cuda"
  ],
  "context_depths": [
    2048,
    4096
  ],
  "thread_profiles": [
    "physical",
    "logical"
  ],
  "ubatch_sizes": [
    64,
    128
  ],
  "batch_size": 512,
  "cache_types": [
    "q8_0",
    "q4_0"
  ],
  "kv_locations": [
    "cpu",
    "gpu"
  ],
  "flash_attention": [
    "off",
    "on"
  ],
  "gpu_layers": {
    "auto": true,
    "sweep": [
      4,
      8,
      12,
      16
    ],
    "fit_target_mib": 1024
  },
  "prompt_tokens": 512,
  "generation_tokens": 128,
  "repetitions": 3,
  "load_mode": "mmap",
  "case_timeout_seconds": 1800,
  "continue_after_expected_failure": true,
  "continue_after_timeout": true,
  "continue_after_memory_elimination": true,
  "telemetry": {
    "sample_interval_seconds": 2,
    "warmup_grace_seconds": 30,
    "minimum_post_warmup_samples": 3,
    "minimum_available_ram_bytes": 1610612736,
    "max_swap_growth_bytes": 268435456,
    "max_process_swap_bytes": 268435456,
    "max_major_fault_rate_per_second": 1.0,
    "max_swapin_bytes_per_second": 1048576,
    "sustained_intervals": 3
  },
  "expected_failure_patterns": [
    "out of memory",
    "cuda error",
    "not supported",
    "unsupported",
    "failed to allocate",
    "failed to create context"
  ]
}
