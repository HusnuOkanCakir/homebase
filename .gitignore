# --- Local tooling -----------------------------------------------------------
.venv/
__pycache__/
*.py[cod]
.pymarkdown_cache/
# mkdocs build output
site/

# --- Go (Phase 2+) -----------------------------------------------------------
/bin/
/dist/
*.test
*.out
vendor/

# --- Node / dashboard (Phase 3+) ---------------------------------------------
node_modules/
dashboard/dist/
dashboard/.vite/
dashboard/test-results/
dashboard/playwright-report/
dashboard/blob-report/
.playwright/
npm-debug.log*
yarn-error.log*

# --- VM lab (Phase 2+) -------------------------------------------------------
# Disk images and ISOs must never be committed. They are large and rebuildable.
*.qcow2
*.img
*.iso
*.vmdk
tests/vm/run/
tests/vm/cache/

# --- Local run ---------------------------------------------------------------
# `make run` scratch state: database, socket, logs. Not test fixtures — a real
# database with a real account in it, which is exactly what should never be
# committed.
/run/

# --- Packaging ---------------------------------------------------------------
*.deb
/build/
/dist/
*.buildinfo
*.changes
packaging/**/debian/files
packaging/**/debian/.debhelper/

# --- Secrets -----------------------------------------------------------------
# Belt and braces: gitleaks + GitHub push protection are the real defence, but
# keep the obvious shapes out of the working tree entirely.
*.pem
*.key
*.p12
*.pfx
.env
.env.*
!.env.example
secrets/

# --- Editors and OS ----------------------------------------------------------
.idea/
*.swp
*~
.DS_Store
Thumbs.db

# --- Agent tooling -----------------------------------------------------------
# Per-developer Claude Code settings; the shared .claude/settings.json (if any)
# is committed deliberately.
.claude/settings.local.json
bin/

# Research spikes live on their own branches, never on main.
#
# `research/` is tracked on perf/qwen38-* and deliberately absent here: it is an
# experiment in what a Stage 2 agent might run on this hardware, not part of the
# product, and merging it would put a model lab in the release history.
#
# Ignored rather than merely uncommitted because `git add -A` swept the whole
# directory into an unrelated commit once already — the working tree holds those
# files whenever anybody has checked out one of those branches.
research/
