# https://editorconfig.org
# Enforced in CI by the `ci/hygiene` job (editorconfig-checker).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.go]
indent_style = tab
indent_size = 4

[*.{js,jsx,ts,tsx,css,scss,json,json5}]
indent_size = 2

[*.{yml,yaml}]
indent_size = 2

[*.md]
indent_size = 2
# Markdown uses two trailing spaces for a hard line break.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab

[*.{sh,bash}]
indent_size = 2

[LICENSE]
# Verbatim Apache-2.0 text: never reformat.
indent_style = unset
indent_size = unset
trim_trailing_whitespace = false
insert_final_newline = unset
